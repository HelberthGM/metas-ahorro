# Configuración de Elastic Beanstalk (plataforma Python).
# El health check apunta a /health, que en app.py devuelve {"status":"ok"} con 200.
option_settings:
  # Balanceador (clásico o de aplicación): ruta del chequeo HTTP.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health

  # Target group del ALB (plataformas AL2023): misma ruta de chequeo.
  # Si el entorno es SingleInstance (sin balanceador), esta sección se puede quitar.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
